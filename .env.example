# Copy to .env and edit. All keys are optional; defaults are in vanta/config.py.
VANTA_ENVIRONMENT=local
VANTA_LOG_LEVEL=INFO
VANTA_DATA_DIR=data
VANTA_DATABASE_URL=sqlite:///data/vanta.db
VANTA_ASSET=ETH-USD
VANTA_HORIZON_SECONDS=900
VANTA_SUBMISSION_WINDOW_SECONDS=30
VANTA_CANDLE_INTERVAL_SECONDS=60
VANTA_LOOKBACK_CANDLES=600

# Bittensor chain layer (Phase 5). Wallet NAMES only — key material lives in
# ~/.bittensor/wallets and never in this repo (ARCHITECTURE.md §45).
VANTA_NETUID=1
VANTA_CHAIN_NETWORK=local
VANTA_WALLET_NAME=default
VANTA_WALLET_HOTKEY=default
VANTA_AXON_HOST=0.0.0.0
VANTA_AXON_PORT=8091
# Public IP published on chain via ServeAxon. The chain rejects loopback.
VANTA_AXON_ANNOUNCE_IP=
VANTA_REQUEST_TIMEOUT_SECONDS=10.0
VANTA_MINER_ENGINE=momentum
